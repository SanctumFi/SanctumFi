# Extension proxy configuration for Coston2.
# Copy this file to extension_proxy.toml and fill in your DB credentials.

[database]
host = "localhost"
port = 5432
user = "your_db_user"
password = "your_db_password"
name = "tee_proxy"

[chain]
rpc_url = "https://coston2-api.flare.network/ext/C/rpc"
chain_id = 114

[proxy]
internal_port = 6663
external_port = 6664

[redis]
url = "redis://redis:6379"
